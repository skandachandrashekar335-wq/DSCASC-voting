# Firebase web configuration (public — safe to expose in frontend).
# Copy this file to ".env.local" and fill in your Firebase project values.
# Find these in Firebase Console -> Project settings -> Your apps -> Web app.

VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID

# Cloudinary (images only — candidate photos & college logo).
# Both values are PUBLIC/client-safe (used for unsigned browser uploads).
# NEVER put CLOUDINARY_API_SECRET in any VITE_* variable or frontend code.
# 1. Create an UNSIGNED upload preset in Cloudinary (Settings -> Upload -> Upload presets).
# 2. Set VITE_CLOUDINARY_CLOUD_NAME to your Cloudinary cloud name.
# 3. Set VITE_CLOUDINARY_UPLOAD_PRESET to that unsigned preset name.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
