# ---- Server ----
PORT=4000
APP_URL=http://localhost:5173
NODE_ENV=development

# ---- Firebase Admin (server-side ONLY) ----
# Option A (recommended): path to the service account key JSON you downloaded
# from Firebase Console > Project settings > Service accounts.
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccount.json

# Option B: paste the entire JSON as an env var instead of a file.
# FIREBASE_SERVICE_ACCOUNT_JSON=

# ---- Firebase Web (used by the FRONTEND, these are public by design) ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---- Groq AI (server-side ONLY, never exposed to the browser) ----
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- CORS / misc ----
CORS_ORIGIN=http://localhost:5173
MAX_PHOTO_SIZE_MB=5
