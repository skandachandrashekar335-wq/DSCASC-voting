{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    { "src": "backend/api/index.ts", "use": "@vercel/node", "config": { "maxDuration": 30 } },
    { "src": "frontend/package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/api/index.ts" },
    { "src": "/uploads/(.*)", "dest": "backend/api/index.ts" },
    { "src": "/assets/(.*)", "dest": "frontend/dist/assets/$1" },
    { "src": "/(.*\\.(js|css|svg|png|jpg|jpeg|webp|ico|json|woff2?|txt|webmanifest))", "dest": "frontend/dist/$1" },
    { "src": "/(.*)", "dest": "frontend/dist/index.html" }
  ]
}
