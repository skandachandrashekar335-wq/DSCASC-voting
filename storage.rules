rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Election media: publicly readable (photos/logos shown on public pages),
    // writable by any signed-in user (admin or candidate) under the election path.
    match /elections/{electionId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size <= 5 * 1024 * 1024
                   && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
    }
  }
}
